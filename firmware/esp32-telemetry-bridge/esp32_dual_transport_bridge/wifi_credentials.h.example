/**
 * AERON ESP32 Dual-Transport Bridge — Local Mobile Hotspot Credentials Template
 *
 * INSTRUCTIONS:
 * 1. Copy this file to "wifi_credentials.h" in the same directory:
 *    cp wifi_credentials.h.example wifi_credentials.h
 * 2. Update AERON_WIFI_SSID with your smartphone's mobile hotspot name.
 * 3. Update AERON_WIFI_PASSWORD with your hotspot's WPA2 password.
 * 4. The file "wifi_credentials.h" is excluded in .gitignore and will NEVER be committed.
 */

#ifndef WIFI_CREDENTIALS_H
#define WIFI_CREDENTIALS_H

#define AERON_WIFI_SSID       "YourPhoneHotspotName"
#define AERON_WIFI_PASSWORD   "YourHotspotPassword"

#endif // WIFI_CREDENTIALS_H

